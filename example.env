PORT=18080
BASE_URL=http://127.0.0.1:18080
# Primary SQLite Core database path (only one database variable needed; plugin databases and logs sit alongside it)
DATABASE_PATH=.data/core.db
PLUGINS_DIR=/home/kieren/Documents/code/optimis/plugins
# PRELOAD_PLUGINS accepts:
#   - "none" or empty (boot with 0 plugins preloaded)
#   - "all" or a parent directory path like "/home/kieren/Documents/code/optimis/plugins" (preload all production plugins in that folder)
#   - a single plugin folder name/path (e.g. "timetable_attendance_plugin" or "./plugins/timetable_attendance_plugin")
#   - a comma-separated list of plugin folders (e.g. "timetable_attendance_plugin,behaviour_plugin,staff_cover_plugin")
PRELOAD_PLUGINS=none
SCHOOL_URN=100001
HOST_KMS_KEY_HANDLE=kms-local-dev-key-001
ENABLE_DEV_PERSONA_SWITCHER=true
ENABLE_REAL_HTTP_EGRESS=false
ENABLE_MOCK_DFE_CENSUS_SERVICE=true
ENABLE_REAL_CLOUD_KMS=false
ENABLE_REAL_PARENT_DMZ_SYNC=false
ENABLE_REAL_MAT_SYNC=false
