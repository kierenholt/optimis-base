PORT=18080
BASE_URL=http://127.0.0.1:18080
# Primary SQLite Core database path (only one database variable needed; plugin databases and logs sit alongside it)
DATABASE_PATH=.data/core.db
# Plugins directory: set to your plugins directory to load all plugins, or leave BLANK (PLUGINS_DIR=) for NO plugins!
PLUGINS_DIR=plugins
SCHOOL_URN=100001
HOST_KMS_KEY_HANDLE=kms-local-dev-key-001
ENABLE_DEV_PERSONA_SWITCHER=true
# Default staff persona when ENABLE_DEV_PERSONA_SWITCHER=true (can also override live via ?__persona=<id> in URL or X-MIS-Persona header):
#   stf_admin_01  = Dame Eleanor Vance (ADMIN — full :all scopes, GDPR SAR Redaction, Diagnostics, Role Defaults)
#   stf_dsl_01    = Mr Marcus Thorne (DSL — unlocks Envelope-Encrypted Safeguarding Vault)
#   stf_senco_01  = Dr Priya Nair (SENCO — school-wide SEN :all scopes)
#   stf_hod_maths = Mr David Sterling (HOD — Head of Maths, department :all scopes & plugin config)
#   stf_tch_7a    = Ms Hannah Abbott (TEACHER — Form 7A & 7A/Ma1, :own_groups)
#   stf_tch_7b    = Mr Simon Barker (TEACHER — Form 7B & 7B/En1, :own_groups negative control)
#   stf_ta_01     = Mrs Sarah Jenkins (TA — SUPPORT role assigned to 7A / Noah Williams)
#   stf_supply_01 = Mr Gareth Cole (TEACHER — Agency Cover Teacher, starts with 0 groups)
#   stf_001       = Default synthetic Teacher persona
TEST_DEFAULT_PERSONA=stf_001
ENABLE_REAL_HTTP_EGRESS=false
ENABLE_MOCK_DFE_CENSUS_SERVICE=true
ENABLE_REAL_CLOUD_KMS=false
ENABLE_REAL_PARENT_DMZ_SYNC=false
ENABLE_REAL_MAT_SYNC=false
