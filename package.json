{
  "name": "optimis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev_watch.mjs",
    "dev:all-plugins": "PRELOAD_PLUGINS=all node scripts/dev_watch.mjs --all-plugins",
    "dev:no-plugins": "PRELOAD_PLUGINS=none node scripts/dev_watch.mjs --no-plugins",
    "start": "./bin/mis-server",
    "start:all-plugins": "PRELOAD_PLUGINS=all ./bin/mis-server --all-plugins",
    "start:no-plugins": "PRELOAD_PLUGINS=none ./bin/mis-server --no-plugins",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:go": "go build -o bin/mis-server ./cmd/mis-server",
    "build": "npm run build:ui && npm run build:go",
    "seed": "go run ./cmd/mis-seed-qa",
    "seed:qa": "go run ./cmd/mis-seed-qa -db .data/qa_core.db",
    "seed:dev": "go run ./cmd/mis-seed-qa --overwrite-dev-db",
    "plugins:all": "node scripts/manage_plugins.mjs all",
    "plugins:none": "node scripts/manage_plugins.mjs none",
    "plugins:load": "node scripts/manage_plugins.mjs load",
    "plugins:status": "node scripts/manage_plugins.mjs status",
    "logs:tail": "node scripts/tail_logs.mjs",
    "logs:tail:file": "node scripts/tail_logs.mjs --file",
    "test": "bash -c 'if [ -z \"$1\" ]; then echo \"Error: test name is required\" >&2; exit 1; fi; npx playwright test -g \"$1\" --workers=1' --",
    "test:go": "bash -c 'if [ -n \"$1\" ]; then go test -v ./internal/... -run \"$1\"; else go test -v ./internal/...; fi' --",
    "test:e2e": "npx playwright test --workers=1",
    "test:emulator": "npx playwright test --workers=1",
    "test:live": "npx playwright test --workers=1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
