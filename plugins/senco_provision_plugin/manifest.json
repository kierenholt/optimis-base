{
  "id": "uk.org.optimis.sen.provision",
  "title": "SEN Provision & Differentiation",
  "icon": "heart-pulse",
  "version": "0.1.0",
  "core_dal_version": "~1.0",
  "max_concurrency": 4,
  "max_memory_mb": 32,
  "database": {
    "alias": "plugin_sen_provision",
    "max_db_size_mb": 64
  },
  "gdpr_hooks": {
    "export_pupil_data": "export_pupil_data",
    "purge_pupil_data": "purge_pupil_data"
  },
  "egress": {
    "allowed_domains": []
  },
  "endpoints": {
    "log_iep_provision": {
      "scopes": ["dal.pupils.read:all", "dal.sen.read:all"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "get_sen_differentiation_summary": {
      "scopes": ["dal.pupils.read:own_groups", "dal.sen.read:own_groups", "dal.groups.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    }
  },
  "views": [
    {
      "id": "home",
      "path": "/",
      "title": "SEN Register Overview",
      "entry": "ui/dist/index.html",
      "keywords": [
        "sen",
        "send",
        "senco",
        "ehcp",
        "iep",
        "differentiation",
        "special educational needs",
        "ta support"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "student",
      "path": "/student/:pupil_id",
      "title": "Pupil SEN & IEP Profile",
      "entry": "ui/dist/index.html",
      "keywords": [
        "iep",
        "ehcp",
        "sen passport",
        "adjustments",
        "teaching assistant",
        "send profile"
      ],
      "query_params": [
        "tab",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "group",
      "path": "/group/:group_id",
      "title": "Classroom SEN Differentiation",
      "entry": "ui/dist/index.html",
      "keywords": [
        "differentiation",
        "classroom adjustments",
        "sen strategies",
        "group send"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    }
  ],
  "widgets": [
    {
      "id": "sen_differentiation",
      "title": "Classroom SEN Differentiation",
      "entry": "ui/dist/widget.html",
      "width": 2,
      "height": 1,
      "keywords": [
        "sen",
        "send",
        "ehcp",
        "iep",
        "differentiation",
        "strategies",
        "adjustments"
      ]
    }
  ]
}
