{
  "id": "uk.org.optimis.behaviour",
  "title": "Behaviour & Pastoral Points",
  "icon": "award",
  "version": "0.2.0",
  "core_dal_version": "~1.0",
  "max_concurrency": 4,
  "max_memory_mb": 32,
  "database": {
    "alias": "plugin_behaviour",
    "max_db_size_mb": 64
  },
  "gdpr_hooks": {
    "export_pupil_data": "export_pupil_data",
    "purge_pupil_data": "purge_pupil_data"
  },
  "egress": {
    "allowed_domains": []
  },
  "endpoints": {
    "log_behaviour_event": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "get_pupil_behaviour_summary": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    }
  },
  "views": [
    {
      "id": "home",
      "path": "/",
      "title": "Behaviour & Pastoral Points",
      "entry": "ui/dist/index.html",
      "keywords": [
        "merit",
        "demerit",
        "detention",
        "sanction",
        "reward",
        "conduct",
        "pastoral",
        "incident"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "student",
      "path": "/student/:pupil_id",
      "title": "Pupil Behaviour Profile",
      "entry": "ui/dist/index.html",
      "keywords": [
        "merit",
        "demerit",
        "detention",
        "sanction",
        "pupil conduct",
        "behaviour log"
      ],
      "query_params": [
        "tab",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "group",
      "path": "/group/:group_id",
      "title": "Group Behaviour Summary",
      "entry": "ui/dist/index.html",
      "keywords": [
        "class behaviour",
        "group merits",
        "form conduct",
        "pastoral summary"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    }
  ],
  "widgets": [
    {
      "id": "behaviour_summary",
      "title": "Behaviour & Merits Summary",
      "description": "Wide 2x1 summary of positive merits, conduct points, and pastoral behaviour trends across your groups.",
      "entry": "ui/dist/widget.html",
      "width": 2,
      "height": 1,
      "keywords": [
        "merit",
        "demerit",
        "detention",
        "sanction",
        "pastoral",
        "reward points"
      ]
    }
  ]
}
