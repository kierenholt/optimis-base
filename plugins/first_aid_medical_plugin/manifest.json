{
  "id": "uk.org.optimis.medical.firstaid",
  "title": "Medical Room & First Aid",
  "icon": "stethoscope",
  "version": "1.0.0",
  "core_dal_version": "~1.0",
  "database": {
    "alias": "plugin_first_aid"
  },
  "egress": {
    "allowed_domains": []
  },
  "gdpr_hooks": {
    "export_pupil_data": "export_pupil_data",
    "purge_pupil_data": "purge_pupil_data"
  },
  "endpoints": {
    "get_pupil_first_aid_profile": {
      "scopes": [
        "dal.pupils.read:all",
        "dal.medical.read:all",
        "dal.guardians.read:all"
      ],
      "mutates": false
    },
    "log_first_aid_treatment": {
      "scopes": [
        "dal.pupils.read:all",
        "dal.medical.read:all",
        "dal.guardians.read:all"
      ],
      "mutates": true
    },
    "export_pupil_data": {
      "scopes": [
        "dal.pupils.read:all"
      ],
      "mutates": false
    },
    "purge_pupil_data": {
      "scopes": [
        "dal.pupils.write:all"
      ],
      "mutates": true
    }
  },
  "workers": {
    "on_first_aid_logged": {
      "events": [
        "plugin.uk.org.optimis.medical.firstaid.logged"
      ],
      "scopes": [
        "dal.pupils.read:all"
      ],
      "mutates": true
    }
  },
  "views": [
    {
      "id": "home",
      "path": "/",
      "title": "Medical Room & First Aid",
      "entry": "ui/dist/index.html",
      "keywords": [
        "nurse",
        "injury",
        "anaphylaxis",
        "epipen",
        "ihcp",
        "allergy",
        "medication",
        "treatment"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "student",
      "path": "/student/:pupil_id",
      "title": "Pupil Medical & First Aid Profile",
      "entry": "ui/dist/index.html",
      "keywords": [
        "allergy",
        "anaphylaxis",
        "ihcp",
        "first aid log",
        "emergency contact"
      ],
      "query_params": [
        "tab",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    }
  ]
}
