{
  "id": "uk.org.optimis.medical.firstaid",
  "title": "Medical Room & First Aid",
  "version": "1.0.0",
  "core_dal_version": "~1.0",
  "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 2a2 2 0 0 0-2 2v5H4a2 2 0 0 0-2 2v2c0 1.1.9 2 2 2h5v5c0 1.1.9 2 2 2h2a2 2 0 0 0 2-2v-5h5a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-5V4a2 2 0 0 0-2-2h-2z\"/></svg>",
  "database": {
    "alias": "plugin_first_aid"
  },
  "egress": {
    "allowed_domains": []
  },
  "gdpr_hooks": {
    "export_pupil_data": "export_pupil_data",
    "purge_pupil_data": "purge_pupil_data"
  },
  "endpoints": {
    "get_pupil_first_aid_profile": {
      "scopes": [
        "dal.pupils.read:all",
        "dal.medical.read:all",
        "dal.guardians.read:all"
      ],
      "mutates": false
    },
    "log_first_aid_treatment": {
      "scopes": [
        "dal.pupils.read:all",
        "dal.medical.read:all",
        "dal.guardians.read:all"
      ],
      "mutates": true
    },
    "export_pupil_data": {
      "scopes": [
        "dal.pupils.read:all"
      ],
      "mutates": false
    },
    "purge_pupil_data": {
      "scopes": [
        "dal.pupils.write:all"
      ],
      "mutates": true
    }
  },
  "workers": {
    "on_first_aid_logged": {
      "events": [
        "plugin.uk.org.optimis.medical.firstaid.logged"
      ],
      "scopes": [
        "dal.pupils.read:all"
      ],
      "mutates": true
    }
  }
}
