{
  "id": "uk.org.optimis.test",
  "version": "0.2.0",
  "core_dal_version": "~1.0",
  "database": {
    "alias": "plugin_test",
    "max_db_size_mb": 64
  },
  "gdpr_hooks": {
    "export_pupil_data": "export_pupil_data",
    "purge_pupil_data": "purge_pupil_data"
  },
  "egress": {
    "allowed_domains": ["https://sync.sparxmaths.uk", "https://api.dfe.gov.uk"],
    "timeout_ms": 1500
  },
  "endpoints": {
    "get_pupil_record": {
      "scopes": ["dal.pupils.read:all"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "save_pupil_note": {
      "scopes": ["dal.pupils.read:all"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "list_pupil_notes": {
      "scopes": ["dal.pupils.read:all"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "export_pupil_data": {
      "scopes": ["dal.pupils.read:all"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "purge_pupil_data": {
      "scopes": ["dal.pupils.read:all"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "get_group_roster_summary": {
      "scopes": ["dal.pupils.read:own_groups", "dal.groups.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "get_pupil_guardians": {
      "scopes": ["dal.guardians.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "record_group_am_attendance": {
      "scopes": ["dal.attendance.read:own_groups", "dal.attendance.write:own_groups"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "submit_safeguarding_postbox": {
      "scopes": ["dal.safeguarding.create"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "sync_external_sparx_get": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "push_external_sparx_post": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "mutate_then_illegal_egress": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": true,
      "timeout_ms": 2500
    },
    "trigger_loop_relay": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    },
    "list_worker_event_logs": {
      "scopes": ["dal.pupils.read:own_groups"],
      "mutates": false,
      "timeout_ms": 2500
    }
  },
  "workers": {
    "on_core_event_audit": {
      "events": [
        "core.attendance.session_recorded",
        "core.safeguarding.postbox_created",
        "core.group.membership_changed"
      ],
      "scopes": ["dal.pupils.read:all"],
      "mutates": true,
      "timeout_ms": 30000,
      "max_concurrency": 2
    },
    "on_loop_relay": {
      "events": ["test.loop_relay"],
      "scopes": ["dal.pupils.read:all"],
      "mutates": true,
      "timeout_ms": 30000,
      "max_concurrency": 1
    }
  },
  "views": [
    {
      "id": "home",
      "path": "/",
      "title": "Pupil & Classroom Workspace",
      "entry": "ui/dist/index.html",
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "absent_staff_id",
        "cover_staff_id",
        "slot_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "student",
      "path": "/student/:pupil_id",
      "title": "Pupil Profile",
      "entry": "ui/dist/index.html",
      "query_params": [
        "tab",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "group",
      "path": "/group/:group_id",
      "title": "Group Roster",
      "entry": "ui/dist/index.html",
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "staff",
      "path": "/staff/:staff_id",
      "title": "Staff Workspace",
      "entry": "ui/dist/index.html",
      "query_params": [
        "tab",
        "pupil_id",
        "group_id",
        "reference_date",
        "academic_year_id"
      ]
    }
  ],
  "widgets": [
    {
      "id": "attendance_pulse",
      "title": "Statutory Attendance Pulse",
      "entry": "ui/dist/widget.html"
    },
    {
      "id": "pastoral_watch",
      "title": "Pastoral & Behaviour Watch",
      "entry": "ui/dist/widget.html"
    }
  ]
}
