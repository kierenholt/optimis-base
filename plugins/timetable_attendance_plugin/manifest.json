{
  "id": "uk.org.optimis.timetable.attendance",
  "title": "Timetable & Statutory Attendance",
  "icon": "calendar",
  "version": "0.1.0",
  "core_dal_version": "~1.0",
  "egress": {
    "allowed_domains": []
  },
  "endpoints": {
    "load_staff_timetable": {
      "scopes": [
        "dal.groups.read:own_groups"
      ],
      "mutates": false
    },
    "load_slot_roster_with_flags": {
      "scopes": [
        "dal.groups.read:own_groups",
        "dal.pupils.read:own_groups",
        "dal.sen.read:own_groups",
        "dal.medical.read:own_groups",
        "dal.attendance.read:own_groups"
      ],
      "mutates": false
    },
    "submit_session_attendance_batch": {
      "scopes": [
        "dal.groups.read:own_groups",
        "dal.pupils.read:own_groups",
        "dal.attendance.read:own_groups",
        "dal.attendance.write:own_groups"
      ],
      "mutates": true
    }
  },
  "views": [
    {
      "id": "home",
      "path": "/",
      "title": "Timetable & Statutory Attendance",
      "entry": "ui/dist/index.html",
      "keywords": [
        "register",
        "roll call",
        "mark attendance",
        "schedule",
        "lessons",
        "am pm session",
        "lateness"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "slot_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "group",
      "path": "/group/:group_id",
      "title": "Class Session Register",
      "entry": "ui/dist/index.html",
      "keywords": [
        "take register",
        "session attendance",
        "class roll call",
        "mark present"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "other_group_id",
        "slot_id",
        "reference_date",
        "academic_year_id"
      ]
    }
  ]
}
