{
  "id": "uk.org.optimis.ops.trips",
  "title": "Educational Visits & Trip Consent",
  "icon": "bus",
  "version": "0.1.0",
  "core_dal_version": "~1.0",
  "max_concurrency": 4,
  "max_memory_mb": 32,
  "database": {
    "alias": "plugin_trips",
    "max_db_size_mb": 64
  },
  "gdpr_hooks": {
    "export_pupil_data": "export_pupil_data",
    "purge_pupil_data": "purge_pupil_data"
  },
  "egress": {
    "allowed_domains": []
  },
  "endpoints": {
    "create_trip": {
      "scopes": [
        "dal.groups.read:own_groups",
        "dal.pupils.read:own_groups"
      ],
      "mutates": true,
      "timeout_ms": 2500
    },
    "record_trip_consent": {
      "scopes": [
        "dal.groups.read:own_groups",
        "dal.pupils.read:own_groups",
        "dal.guardians.read:own_groups"
      ],
      "mutates": true,
      "timeout_ms": 2500
    },
    "generate_trip_emergency_pack": {
      "scopes": [
        "dal.groups.read:own_groups",
        "dal.pupils.read:own_groups",
        "dal.sen.read:own_groups",
        "dal.medical.read:own_groups",
        "dal.guardians.read:own_groups"
      ],
      "mutates": false,
      "timeout_ms": 2500
    },
    "get_trip_details": {
      "scopes": [
        "dal.groups.read:own_groups",
        "dal.pupils.read:own_groups",
        "dal.guardians.read:own_groups"
      ],
      "mutates": false,
      "timeout_ms": 2500
    }
  },
  "workers": {
    "on_parent_dmz_submission": {
      "events": [
        "core.parent_dmz.submission_received"
      ],
      "scopes": [
        "dal.pupils.read:all",
        "dal.guardians.read:all"
      ],
      "mutates": true,
      "timeout_ms": 5000,
      "max_concurrency": 1
    }
  },
  "views": [
    {
      "id": "home",
      "path": "/",
      "title": "Educational Visits & Trip Consent",
      "entry": "ui/dist/index.html",
      "keywords": [
        "trip",
        "excursion",
        "educational visit",
        "consent",
        "emergency pack",
        "outing"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "group_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    },
    {
      "id": "group",
      "path": "/group/:group_id",
      "title": "Group Trip Consent & Manifest",
      "entry": "ui/dist/index.html",
      "keywords": [
        "trip manifest",
        "group consent",
        "emergency pack"
      ],
      "query_params": [
        "tab",
        "pupil_id",
        "second_pupil_id",
        "other_group_id",
        "reference_date",
        "academic_year_id"
      ]
    }
  ]
}
